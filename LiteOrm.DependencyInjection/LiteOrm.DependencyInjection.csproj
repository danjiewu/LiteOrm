<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0;</TargetFrameworks>
		<RootNamespace>LiteOrm.DependencyInjection</RootNamespace>
		<AssemblyVersion>8.1.2.0</AssemblyVersion>
		<FileVersion>8.1.2.0</FileVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<VersionPrefix>8.1.2</VersionPrefix>
		<Nullable>enable</Nullable>
		<Title>LiteOrm.DependencyInjection</Title>
		<Authors>danjiewu</Authors>
		<Description>LiteOrm.DependencyInjection DI 扩展：LiteOrm 的依赖注入与 AOP 集成层。基于 Autofac 与 Castle DynamicProxy，通过 RegisterLiteOrm() 一键注册，支持声明式事务、权限、日志拦截与自动建表。</Description>
		<PackageProjectUrl>https://danjiewu.github.io/LiteOrm</PackageProjectUrl>
		<PackageTags>orm;autofac;castle;proxy;aop;interceptor;di;ioc</PackageTags>
		<RepositoryUrl>https://github.com/danjiewu/LiteOrm.git</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.DependencyInjection.nuget.md</PackageReadmeFile>
		<PackageReleaseNotes>
8.1.2:
- LiteOrm.Common 更新至 8.1.2。

8.1.1:
- 破坏性变更：
  - RegisterLiteOrm() 移除 LiteOrmOptions.RegisterScope 选项，作用域跟踪始终默认启用。
- 新特性：
  - RegisterLiteOrm() 的 LiteOrmOptions 新增 AutoRegisterServices 选项（默认 true），设为 false 可跳过自动扫描注册；
  - 自动注册时，带 [Service] 特性（IsService = true）的类型自动应用 ServiceInvokeInterceptor。

8.1.0:
- 破坏性变更：
  - 核心实体服务与数据访问对象由 [AutoRegister] 扫描改为 RegisterCoreServices() 显式注册；
  - 数据源配置由 DataSourceProviderExtensions 从宿主 IConfiguration 的 LiteOrm 节点加载。
- 新特性：
  - 新增 LiteOrm.DependencyInjection 包，RegisterLiteOrm() 由 LiteOrm 基础包移至本包（命名空间 LiteOrm.DependencyInjection）；
  - 基于 Autofac 与 Castle DynamicProxy 的 AOP 拦截（事务 / 权限 / 日志）；
  - 自动应用 [AutoRegister] 源生成注册；
  - 宿主集成 / Remote 使用单例 ProxyGenerator 优化性能。
    </PackageReleaseNotes>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.DependencyInjection.nuget.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Autofac.Extras.DynamicProxy" Version="7.1.0" />
		<PackageReference Include="Castle.Core" Version="5.1.1" />
		<PackageReference Include="Castle.Core.AsyncInterceptor" Version="2.1.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1' OR '$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.2.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="2.2.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="2.2.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LiteOrm\LiteOrm.csproj" />
		<ProjectReference Include="..\LiteOrm.Common\LiteOrm.Common.csproj" />
	</ItemGroup>

</Project>
