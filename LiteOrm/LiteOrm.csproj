<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>LiteOrm</RootNamespace>
		<AssemblyVersion>8.1.0.0</AssemblyVersion>
		<FileVersion>8.1.0.0</FileVersion>
		<TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0;</TargetFrameworks>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<VersionPrefix>8.1.0</VersionPrefix>
		<Nullable>enable</Nullable>
		<Title>LiteOrm</Title>
		<Authors>danjiewu</Authors>
		<Description>LiteOrm 是一个轻量级、高性能的 .NET ORM (对象关系映射) 框架。</Description>
		<PackageProjectUrl>https://danjiewu.github.io/LiteOrm</PackageProjectUrl>
		<PackageReadmeFile>README.nuget.md</PackageReadmeFile>
		<PackageTags>orm;sql;oracle;mysql;sql server;sqlite</PackageTags>
		<PackageReleaseNotes>
      8.1.0 Breaking Change: AutoRegisterAttribute 从 LiteOrm.Common 迁移至 LiteOrm.Framework；
      LiteOrm 核心的 DAO/Service 不再使用 [AutoRegister] 特性自动注册，改为由 LiteOrm.Framework 显式注册；
      LiteOrm 核心项目移除 Microsoft.Extensions.Hosting 依赖，DI 集成仅由 LiteOrm.Framework 提供；
      DataSourceProvider 新增 LoadConfiguration 扩展方法，支持从 IConfiguration 读取配置；
      BulkProvider 改为直接设置 SqlBuilder.BulkProvider 属性；
      Lifetime 枚举移除，AutoRegisterAttribute.Lifetime 改用内置 ServiceLifetime（默认 Scoped）；
    </PackageReleaseNotes>
		<Copyright>Copyright @ 2026 danjiewu</Copyright>
		<RepositoryUrl>https://github.com/danjiewu/LiteOrm.git</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|netstandard2.0|AnyCPU'">
		<DefineConstants>TRACE</DefineConstants>
		<DocumentationFile>bin\Release\LiteOrm.xml</DocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netstandard2.0|AnyCPU'">
		<DocumentationFile>bin\Debug\LiteOrm.xml</DocumentationFile>
		<OutputPath></OutputPath>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\README.nuget.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LiteOrm.Framework" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LiteOrm.Common\LiteOrm.Common.csproj" />
	</ItemGroup>

</Project>
