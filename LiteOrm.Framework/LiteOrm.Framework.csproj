<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0;</TargetFrameworks>
		<RootNamespace>LiteOrm.Framework</RootNamespace>
		<AssemblyVersion>8.1.0.0</AssemblyVersion>
		<FileVersion>8.1.0.0</FileVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<VersionPrefix>8.1.0</VersionPrefix>
		<Nullable>enable</Nullable>
		<Title>LiteOrm.Framework</Title>
		<Authors>danjiewu</Authors>
		<Description>LiteOrm Framework - Autofac DI 适配器 + Castle DynamicProxy 拦截器</Description>
		<PackageProjectUrl>https://danjiewu.github.io/LiteOrm</PackageProjectUrl>
		<PackageTags>orm;autofac;castle;proxy;aop;interceptor;di;ioc</PackageTags>
		<RepositoryUrl>https://github.com/danjiewu/LiteOrm.git</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>
      8.1.0 Breaking Change: AutoRegisterAttribute 从 LiteOrm.Common 迁移至 LiteOrm.Framework；
      LiteOrm 核心的 DAO/Service 不再使用 [AutoRegister] 特性自动注册，改为由 LiteOrm.Framework 显式注册；
      LiteOrm.Framework 新增核心实体服务与数据访问对象的显式注册；
      DataSourceProvider 配置从 IConfiguration 读取改为 LiteOrm.Framework 的 DataSourceProviderExtensions；
      Lifetime 枚举移除，AutoRegisterAttribute.Lifetime 改用内置 ServiceLifetime（默认 Scoped）；
    </PackageReleaseNotes>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Autofac.Extras.DynamicProxy" Version="7.1.0" />
		<PackageReference Include="Castle.Core" Version="5.2.1" />
		<PackageReference Include="Castle.Core.AsyncInterceptor" Version="2.1.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LiteOrm\LiteOrm.csproj" />
		<ProjectReference Include="..\LiteOrm.Common\LiteOrm.Common.csproj" />
	</ItemGroup>

</Project>
